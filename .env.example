# Copy this file to .env and fill in the keys for the backend(s) you want to run.

# Needed for --backend haiku or both
ANTHROPIC_API_KEY=your-anthropic-api-key

# Needed for --backend jev or both (from https://console.typesafe.ai/)
TYPESAFE_API_KEY=your-typesafe-api-key

# Optional overrides
INBOXHERO_MODEL=claude-haiku-4-5-20251001
JEV_MODEL=jev-latest
REQUEST_DELAY_S=1.0
MAX_RETRIES=4

# Optional: USD per million tokens, so the report can show a Jev cost.
# Leave blank and the report shows "n/a" for Jev cost.
JEV_PRICE_INPUT=
JEV_PRICE_OUTPUT=
